POSTGRES_HOST_PORT=5432
ConnectionStrings__Default="Host=localhost;Port=5432;Database=TMT_civicconnect;Username=postgres;Password=change-me"
Cors__Origins=http://localhost:4200
CIVICCONNECT_DATABASE_URL=postgres://postgres:change-me@localhost:5432/TMT_civicconnect
CIVICCONNECT_DB_HOST=localhost
CIVICCONNECT_DB_PORT=5432
CIVICCONNECT_DB_NAME=TMT_civicconnect
