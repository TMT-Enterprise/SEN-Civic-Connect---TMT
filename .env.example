Jwt__Secret=replace-with-a-long-random-secret-at-least-32-characters
Jwt__Issuer=CivicConnect
Jwt__Audience=CivicConnect.Web
Jwt__ExpiryMinutes=60
Seed__DemoPassword=

# Set Enabled=true and configure SMTP to deliver notifications.
Email__Enabled=false
